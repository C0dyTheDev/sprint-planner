# Generate with: openssl rand -base64 32
AUTH_SECRET=
# The first administrator signs in with this email and password. After signing
# in, change the password in the app; this value is then no longer used.
# Administrators add more members and set their passwords in Settings.
BOOTSTRAP_ADMIN_EMAIL=you@example.com
# At least 10 characters.
BOOTSTRAP_ADMIN_PASSWORD=
# Production: remote libsql://... URL and a Turso database auth token.
# Local development can use file:./local.db (no token required).
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=
# Set this to the canonical Vercel production URL on Vercel.
AUTH_URL=http://localhost:3000
