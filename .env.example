# Create a separate OAuth app for local development and production.
# Local callback: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Use the exact verified email on your GitHub account. Only this email can
# initialize an empty workspace. Administrators can add more members in Settings.
BOOTSTRAP_ADMIN_EMAIL=you@example.com
# Production: remote libsql://... URL and a Turso database auth token.
# Local development can use file:./local.db (no token required).
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=
# Set this to the canonical Vercel production URL on Vercel.
AUTH_URL=http://localhost:3000
